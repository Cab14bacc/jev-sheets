    "try": "node scripts/try.mjs"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.13",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
