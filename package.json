{
  "name": "jev-sheets",
  "version": "0.1.0",
  "private": true,
  "description": "Google Sheets custom functions (JEV_IF, JEV_PROB, JEV_CHOICE, JEV_SCORE) backed by TypeSafe's Jev model.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
